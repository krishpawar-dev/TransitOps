NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/transitops

# Authentication Secrets
JWT_ACCESS_SECRET=transitops_super_secret_access_key_2026
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=transitops_super_secret_refresh_key_2026
JWT_REFRESH_EXPIRY=7d

# Email / SMTP Configuration (Nodemailer fallback to Ethereal in dev)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM=noreply@transitops.com
